# Application Configuration
APP_NAME=kissanmart-app
DEBUG=False
API_V1_STR=/api/v1
SECRET_KEY=kissanmart-super-secret-key-for-maharashtra-agritech-change-in-production

# Database Configuration (SQLite default; replace with PostgreSQL in production)
DATABASE_URL=sqlite:///./app.db

# CORS Configuration (comma-separated origins, or * for all)
BACKEND_CORS_ORIGINS=*

# Gemma AI Call Agent (Get key from Google AI Studio)
GEMMA_API_KEY=your_gemini_or_gemma_api_key_here
GEMMA_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemma-2-9b-it:generateContent
GEMMA_MODEL=gemma-2-9b-it

# Optional Frontend Dist directory override
# FRONTEND_DIST_DIR=frontend/dist
